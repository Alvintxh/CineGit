CINEGIT_DATA_DIR=.data
CINEGIT_SEED_DEMO=true
# Leave empty to use the offline procedural storyboard and FFmpeg provider.
CINEGIT_PROVIDER_URL=
CINEGIT_PROVIDER_TOKEN=
CINEGIT_PROVIDER_MODEL=default
CINEGIT_PROVIDER_TIMEOUT=120
CINEGIT_DEMO_FALLBACK=false
CINEGIT_ESTIMATED_SHOT_COST=0.25
CINEGIT_MCP_TRANSPORT=stdio
CINEGIT_MCP_PORT=8001
